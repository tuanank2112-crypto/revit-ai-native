{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodesk-native-agent.local/schemas/operations/column.create.schema.json",
  "title": "column.create arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["point", "type"],
  "properties": {
    "point": { "$ref": "#/$defs/point3d" },
    "type": { "$ref": "wall.create.schema.json#/$defs/typeSelector" },
    "category": {
      "type": "string",
      "default": "column",
      "description": "column.create always uses the Columns category. This field is accepted for compatibility but is overridden internally."
    },
    "level": { "$ref": "wall.create.schema.json#/$defs/levelSelector" },
    "structural": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["column", "beam", "nonStructural", "none", "false", "structural"] }
      ],
      "default": "column",
      "description": "column.create forces StructuralType.Column regardless."
    },
    "name": {
      "type": "string",
      "description": "Optional column instance name."
    }
  },
  "$defs": {
    "point3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number", "default": 0 }
      }
    }
  }
}
