{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodesk-native-agent.local/schemas/operations/export.dwg.schema.json",
  "title": "export.dwg arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["outputDirectory", "views"],
  "properties": {
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "description": "Existing directory for DWG output."
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../element-reference.schema.json" }
    },
    "baseName": { "type": "string", "default": "export" },
    "overwrite": { "type": "boolean", "default": false },
    "mergeViews": { "type": "boolean", "default": false },
    "version": {
      "enum": ["R2013", "R2010", "R2007", "R2018"],
      "default": "R2013"
    }
  }
}
